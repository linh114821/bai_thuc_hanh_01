#include<stdio.h>
#include<math.h>
int main()
{
	float a,b,c,delta;
	printf("Nhap a, b, c: ");
	scanf("%f %f %f", &a, &b, &c);
	if(a == 0){
		if(b == 0){
			if(c == 0) printf("ptr co VSN\n");
			else printf("ptr VN\n");
			} else {
				printf("ptr co nghiem duy nhat x = %.2f\n", -c/b);
			}
		} else {
			delta = b * b - 4 *a *c;
			if (delta <0) {
				printf("ptr VN\n");
			} else if (delta == 0) {
				printf("ptr co nghiem kep x1 = x2 = %.2f\n", -b/(2*a));
			} else {
				printf("ptr co 2 nghiem pb: ");
				printf("x1 = %2f\n", (-b + sqrt(delta)) / (2*a));
				printf("x2 = %2f\n", (-b - sqrt(delta)) / (2*a));
			}
		}
		return 0;
}
  
